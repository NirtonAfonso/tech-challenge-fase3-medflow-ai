# Copie este arquivo para .env e ajuste apenas localmente.
# NUNCA versione chaves reais. O modo padrão do MedFlow AI não exige chave nenhuma.

# ---------------------------------------------------------------- provedor de LLM
# template  = baseline extrativo determinístico, offline, sem GPU (padrão)
# hf_local  = transformers + adapter LoRA/QLoRA treinado no Colab
# openai    = provedor externo opcional
MEDFLOW_LLM_PROVIDER=template
MEDFLOW_BASE_MODEL_ID=Qwen/Qwen2.5-3B-Instruct
MEDFLOW_ADAPTER_PATH=
MEDFLOW_MAX_NEW_TOKENS=512
MEDFLOW_TEMPERATURE=0.2

# --------------------------------------------------------------------------- RAG
# hashing = determinístico, sem download (padrão) | sentence_transformers = denso
MEDFLOW_EMBEDDING_BACKEND=hashing
MEDFLOW_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
MEDFLOW_EMBEDDING_DIM=512
MEDFLOW_CHUNK_SIZE=400
MEDFLOW_CHUNK_OVERLAP=100
MEDFLOW_RETRIEVER_STRATEGY=hybrid
MEDFLOW_RETRIEVER_K=5
MEDFLOW_MMR_LAMBDA=0.6

# ---------------------------------------------------------------------- caminhos
MEDFLOW_DATA_DIR=data
MEDFLOW_LOG_DIR=logs
MEDFLOW_ARTIFACTS_DIR=artifacts
MEDFLOW_DB_PATH=data/processed/hospital.db
MEDFLOW_VECTOR_STORE_DIR=data/processed/vector_store
MEDFLOW_CORPUS_DIR=data/synthetic/protocols

# --------------------------------------------------------- execução e privacidade
MEDFLOW_ENV=development
LOG_LEVEL=INFO
MEDFLOW_SEED=42
# Salt da pseudonimização. TROQUE em qualquer uso que não seja acadêmico:
# o valor padrão é público e torna os pseudônimos previsíveis.
MEDFLOW_PSEUDONYM_SALT=medflow-academic-salt

# ------------------------------------------------------------ chaves OPCIONAIS
# Necessárias apenas para MEDFLOW_LLM_PROVIDER=openai ou para baixar modelos gated.
OPENAI_API_KEY=
HUGGINGFACE_TOKEN=

# Tracing opcional do LangSmith (desligado por padrão)
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=medflow-ai-fase3
