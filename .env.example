# Copie este arquivo para .env e preencha apenas localmente.
# Nunca versione chaves reais.

OPENAI_API_KEY=
HUGGINGFACE_TOKEN=
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=medflow-ai-fase3

# Diretórios locais
MEDFLOW_DATA_DIR=data
MEDFLOW_LOG_DIR=logs
MEDFLOW_DB_PATH=data/processed/medflow.db

# Execução
MEDFLOW_ENV=development
LOG_LEVEL=INFO
